# Bengal TEX ERP — deployment secrets. Copy to `.env` (git-ignored) and fill in REAL values.
#   cp .env.example .env   &&   edit .env   &&   docker compose up -d --build

# ── SQL Server SA password ──────────────────────────────────────────────────
# Must meet SQL Server complexity: 8+ chars, with upper + lower + digit + symbol.
SA_PASSWORD=ChangeMe_Str0ng!Pass

# ── JWT signing key (>= 32 bytes) ───────────────────────────────────────────
# Generate a fresh one — DO NOT reuse the old committed key (it is compromised):
#   openssl rand -base64 64
JWT_SECRET=replace-with-openssl-rand-base64-64

# ── Device-fingerprint salt ─────────────────────────────────────────────────
#   openssl rand -base64 32
FINGERPRINT_SALT=replace-with-openssl-rand-base64-32

# ── Public origin the browser uses (for CORS) + allowed Host header ──────────
# e.g. http://192.168.1.50:8088  or  https://erp.factory.local
PUBLIC_ORIGIN=http://localhost:8088
ALLOWED_HOSTS=*

# ── Port the web UI is published on ─────────────────────────────────────────
WEB_PORT=8088
