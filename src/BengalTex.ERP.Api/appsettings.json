{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BengalTexERP;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "HangfireConnection": "Server=localhost;Database=BengalTexERP_Hangfire;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "BengalTexERP",
    "Audience": "BengalTexERP.Api",
    "Secret": "REPLACE_WITH_BASE64_256BIT_KEY_AT_LEAST_32_CHARS_MINIMUM_FOR_PROD",
    "AccessTokenExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 7
  },
  "DeviceFingerprint": {
    "Salt": "REPLACE_WITH_RANDOM_SALT_FOR_PRODUCTION_USE_LONG_STRING"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Application": {
    "BaseCurrency": "BDT",
    "DefaultGeoFenceRadiusMeters": 500,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15,
    "FileStorage": {
      "UploadsPath": "uploads"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ]
  }
}