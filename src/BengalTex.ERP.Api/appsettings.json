{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BengalTexERP;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "HangfireConnection": "Server=localhost;Database=BengalTexERP_Hangfire;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "BengalTexERP",
    "Audience": "BengalTexERP.Api",
    "Secret": "",
    "AccessTokenExpiresInMinutes": 15,
    "RefreshTokenExpiresInDays": 7
  },
  "DeviceFingerprint": {
    "Salt": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Application": {
    "FrontendBaseUrl": "http://localhost:4200",
    "BaseCurrency": "BDT",
    "DefaultGeoFenceRadiusMeters": 500,
    "MaxFailedLoginAttempts": 5,
    "LockoutDurationMinutes": 15
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Approvals": {
    "PurchaseOrderThreshold": 50000,
    "PurchaseOrderApproverRole": "Admin"
  },
  "AuditLogRetention": {
    "RetentionDays": 365,
    "BatchSize": 5000,
    "MaxBatchesPerRun": 200
  },
  "Sms": {
    "Provider": "DevLogger"
  },
  "Email": {
    "Provider": "DevLogger",
    "FromAddress": "noreply@bengaltex.com",
    "FromName": "Bengal TEX ERP"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithProcessId"
    ]
  }
}